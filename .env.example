# Neon PostgreSQL connection string
NEXT_APP_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI API key (optional — falls back to local embeddings when unset)
NEXT_APP_OPENAI_API_KEY=sk-...

# Public site origin (optional — defaults to http://localhost:3000)
NEXT_APP_SITE_URL=http://localhost:3000
